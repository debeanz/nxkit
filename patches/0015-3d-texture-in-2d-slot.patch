diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index f040d83..b568408 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -1665,6 +1665,7 @@ typedef struct {
     NSUInteger slice, level;
 } up_blit;
 static up_blit *g_up_blits; static int g_nup_blits, g_up_blitcap;
+static NSMutableArray *g_up_p0;   // nxkit: pairs (3D texture, its 2D plane-0 copy) copied at the end of this batch, after its uploads (tex_fit)
 static NSMutableArray *g_up_texs;   // Target textures in the batch: before the flush, textures may be replaced / released within the same submission
 static id<MTLBuffer> g_up_block;
 static size_t g_up_block_off, g_up_block_size;
@@ -1690,12 +1691,19 @@ static void up_flush(void) {
     if (g_up_ce) {
         m4_end(g_up_ce); g_up_ce = nil;
     }
-    id<MTL4ComputeCommandEncoder> b = g_nup_blits ? g_up_ce = [g_up_cb computeCommandEncoder] : nil;
+    id<MTL4ComputeCommandEncoder> b = g_nup_blits || g_up_p0.count ? g_up_ce = [g_up_cb computeCommandEncoder] : nil;
     if (b) [b barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageAll visibilityOptions:MTL4VisibilityOptionDevice];
     for (int i = 0; b && i < g_nup_blits; i++) {
         up_blit *x = &g_up_blits[i];
         enc_b_copy_buffer_texture(b, x->src, x->off, x->row, x->image, x->size, x->dst, x->slice, x->level, MTLOriginMake(0, 0, 0));
     }
+    if (b && g_up_p0.count) {   // nxkit: the first depth plane of 3D textures bound to 2D slots (tex_fit), after this batch's uploads into them
+        [b barrierAfterEncoderStages:MTLStageBlit beforeEncoderStages:MTLStageBlit visibilityOptions:MTL4VisibilityOptionDevice];
+        for (NSUInteger i = 0; i + 1 < g_up_p0.count; i += 2) { id<MTLTexture> src = g_up_p0[i], dst = g_up_p0[i + 1];
+            for (NSUInteger l = 0; l < dst.mipmapLevelCount && l < src.mipmapLevelCount; l++)
+                enc_b_copy_texture(b, src, 0, l, MTLOriginMake(0, 0, 0), MTLSizeMake(MAX(src.width >> l, 1ul), MAX(src.height >> l, 1ul), 1), dst, 0, l, MTLOriginMake(0, 0, 0)); }
+        [g_up_texs addObjectsFromArray:g_up_p0]; [g_up_p0 removeAllObjects];
+    }
     if (b) { m4_end(b); g_up_ce = nil; }
     id<MTL4CommandBuffer> cb = g_up_cb;
     unsigned slot = (g_up_seq - 1) % 3;
@@ -3371,7 +3379,7 @@ void mtl_prog_release(prog_t *p) { if (p->serial) serial_del(p->serial); }
 // ---------- Descriptor pool: texture ID / sampler ID → object ----------
 // At registration the whole texture object is snapshotted (NVN semantics: the descriptor has been written into the pool); view: the MTLTexture for that ID (a view or the base texture, held via CFBridgingRetain) and the serial-table / guest-write generations at the time it was obtained
 typedef struct { tex_t t; int ok; view_t v; int has_v; void *view; uint64_t view_id, view_rid, view_ser, view_dirty; int view_pkg;   // view_pkg: CPU-written (packaged); only those depend on guest writes (view_dirty)
-                 void *alt, *alt_of; uint64_t alt_rid; uint8_t alt_type;   // alt: compatible view used when the shader's declared type differs from view (tex_fit), alt_of = the view it was built from
+                 void *alt, *alt_of; uint64_t alt_rid, alt_sub; uint8_t alt_type;   // alt: compatible view used when the shader's declared type differs from view (tex_fit), alt_of = the view it was built from; alt_sub: the submission a plane-0 copy was last made in
                  void *ar, *ar_of; uint64_t ar_rid;                         // ar: the alpha-from-red view for the profile's alpha_from_red shaders (tex_alpha_red), ar_of = the view it was built from
                  void *im, *im_of; uint64_t im_rid; } treg_t;              // im: the view an image slot reads in the shader's pixel class (img_fit), im_of = the view it was built from
 static treg_t *g_treg; static int g_ntreg;
@@ -3644,6 +3652,31 @@ static id<MTLTexture> tex_fit(int tid, id<MTLTexture> t, MTLTextureType want, ui
         // Binding alone cannot establish that a mismatched input is sampled; this supported fallback is informational.
         static int noted; if (!noted++) MLOG("cube binding fallback: texture ID %d has a 2D descriptor; zero cube bound (the shader may leave this input unused)", tid);
         id<MTLTexture> z = dummy_tex((int)want, NVN_DPF_FLOAT); *rid = g_dummy_tex_rid[want & 7][NVN_DPF_FLOAT]; return z; }
+    // nxkit: a 3D texture in a 2D slot. Kirby and the Forgotten Land's layout shaders (menus, HUD, text) multiply in a second texture that is a 3D RGBA8 one; a 2D sample of it reads its
+    // first depth plane, while on Metal, which has no 2D view of a 3D texture, the read was undefined and those elements came out invisible (22,957 such bindings in one session). A 2D
+    // texture of plane 0 (every level) is bound instead, copied in the upload batch, which runs before this submission, and copied again in each later submission that binds it, so
+    // what the GPU drew into the 3D texture reaches it one submission later. Only on the submitting thread (the upload batch is its own); elsewhere it stays a reported mismatch
+    if (!ns && want == MTLTextureType2D && have == MTLTextureType3D && tid > 0 && tid < g_ntreg && on_sub_thread()) {
+        treg_t *r = &g_treg[tid];
+        if (!(r->alt && r->alt_of == (__bridge void *)t && r->alt_type == (uint8_t)want)) {
+            if (r->alt) { defer_obj_unref((__bridge id)r->alt); CFRelease(r->alt); r->alt = r->alt_of = NULL; r->alt_rid = 0; }
+            MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:t.pixelFormat width:t.width height:t.height mipmapped:NO];
+            d.mipmapLevelCount = t.mipmapLevelCount; d.usage = MTLTextureUsageShaderRead; d.storageMode = MTLStorageModePrivate; d.swizzle = t.swizzle;
+            id<MTLTexture> c = [g_dev newTextureWithDescriptor:d];
+            if (!c) { RED_ONCE(105, "cannot create the 2D plane-0 copy of a 3D texture (texture ID %d, %lux%lux%lu)", tid, (unsigned long)t.width, (unsigned long)t.height, (unsigned long)t.depth); return nil; }
+            c.label = @"3D texture plane 0"; res_add(c);
+            r->alt = (void *)CFBridgingRetain(c); r->alt_of = (__bridge void *)t; r->alt_type = (uint8_t)want; r->alt_rid = c.gpuResourceID._impl; r->alt_sub = 0;
+            static uint64_t n; if (n++ < 4) MLOG("3D texture in a 2D slot: texture ID %d (%lux%lux%lu, %lu levels, format %lu) bound as a 2D copy of its first depth plane (%llu so far)", tid,
+                                               (unsigned long)t.width, (unsigned long)t.height, (unsigned long)t.depth, (unsigned long)t.mipmapLevelCount, (unsigned long)t.pixelFormat, (unsigned long long)n);
+        }
+        if (r->alt_sub != g_sub_serial) {
+            r->alt_sub = g_sub_serial;
+            up_begin(); if (!g_up_p0) g_up_p0 = [NSMutableArray array];
+            [g_up_p0 addObject:t]; [g_up_p0 addObject:(__bridge id<MTLTexture>)r->alt];
+            if (!g_cb) up_flush();
+        }
+        *rid = r->alt_rid; return (__bridge id<MTLTexture>)r->alt;
+    }
     if (!ns || tid <= 0 || tid >= g_ntreg) return nil;   // no view bridges it: the caller reports it (tex_mis_note)
     treg_t *r = &g_treg[tid];
     if (r->alt && r->alt_of == (__bridge void *)t && r->alt_type == (uint8_t)want) { *rid = r->alt_rid; return (__bridge id<MTLTexture>)r->alt; }
