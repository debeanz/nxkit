 static void tex_evict_idle(void) {
     static long idle = -1; if (idle < 0) { const char *e = getenv("DM_NVN_EVICT_IDLE"); idle = e ? atol(e) : 1800; if (idle > 0) MLOG("idle texture eviction: on (rebuildable textures unused for %ld submissions; DM_NVN_EVICT_IDLE=0 turns it off)", idle); }
