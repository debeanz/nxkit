+// Launcher Screen Scaling: where the game's 16:9 picture goes. Fit: whole, with bars; Stretch: the whole screen, out of shape; Stretch 1.943:1 (2106x1084, the
+// Unity ports' wide ratio): a centred 1.943:1 box, out of shape; Zoom: the whole screen, cut at the top and bottom. The box clips the picture
+static CGRect g_game_rect;   // the picture's rectangle in the root view (DmGamepad.m maps the game's touch screen onto it)
+CGRect front_ios_game_rect(void) { return g_game_rect; }
+static void game_layout(CGRect b, CGRect *box, CGRect *pic) {
+    const char *sc = getenv("DM_IOS_SCALING"); if (!sc) sc = "fit";
+    int stretch = !strcmp(sc, "stretch"), wide = !strcmp(sc, "1943"), zoom = !strcmp(sc, "zoom");
+    CGFloat r = stretch || zoom ? b.size.width / b.size.height : wide ? 2106.0 / 1084.0 : 16.0 / 9.0;   // the box's ratio
+    CGFloat w = b.size.width, h = b.size.height;
+    if (w / h > r) w = h * r; else h = w / r;
+    *box = CGRectMake(floor((b.size.width - w) / 2), floor((b.size.height - h) / 2), w, h);
+    CGFloat pw = w, ph = h;   // Stretch, Stretch 1.943:1 (and Fit, whose box is 16:9): the box itself
+    if (zoom) { if (w / h > 16.0 / 9.0) ph = w * 9.0 / 16.0; else pw = h * 16.0 / 9.0; }   // 16:9 covering the box
+    *pic = CGRectMake(round((w - pw) / 2), round((h - ph) / 2), pw, ph);   // in the box
+}
