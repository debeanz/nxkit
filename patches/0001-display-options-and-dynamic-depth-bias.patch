             VkDynamicState s = dy->pDynamicStates[i];
-            if (s == VK_DYNAMIC_STATE_VIEWPORT) p->dyn_vp = 1; else if (s == VK_DYNAMIC_STATE_SCISSOR) p->dyn_sc = 1; else RED1("dynamic state %d not implemented (the imports have no matching set function)", s);
+            if (s == VK_DYNAMIC_STATE_VIEWPORT) { p->dyn_vp = 1; continue; }
+            if (s == VK_DYNAMIC_STATE_SCISSOR) { p->dyn_sc = 1; continue; }
+            // A dynamic state ignores the pipeline's own value, and the imports have no matching set function, so the game never sets it: the value is the driver's initial one (zero).
+            // Depth bias: Hades (The Forge lists it dynamic) has pipelines with a static bias the Switch never applies; applying it moved layers forward (grey foreground, the HUD bar
+            // hidden behind it). DM_VK_STATIC_BIAS=1 applies the pipeline's value as before
+            static int seen[16], static_bias = -1;
+            if (static_bias < 0) static_bias = getenv("DM_VK_STATIC_BIAS") && atoi(getenv("DM_VK_STATIC_BIAS"));
+            if (s == VK_DYNAMIC_STATE_DEPTH_BIAS && p->bias && !static_bias) {
+                static int n; if (n++ < 8) LOG("[vk] dynamic depth bias: the pipeline's static bias %.3f (slope %.3f, clamp %.3f) is not applied", p->bias_c, p->bias_s, p->bias_cl);
+                p->bias = 0;
+            }
+            if (s < 16 && !seen[s]) { seen[s] = 1; LOG("[vk] dynamic state %d: the game cannot set it (no matching import); %s", s, s == VK_DYNAMIC_STATE_DEPTH_BIAS ? (static_bias ? "the pipeline's bias is applied (DM_VK_STATIC_BIAS)" : "no bias") : "the pipeline's value is used"); }
         }
         const VkPipelineViewportStateCreateInfo *vs = ci->pViewportState;
         if (!p->dyn_vp && vs && vs->pViewports && vs->viewportCount) { p->vp = vp_of(&vs->pViewports[0]); p->has_vp = 1; }
