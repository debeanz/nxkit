+// Launcher Aspect Ratio and Screen Scaling: where the game's 16:9 picture goes. The aspect ratio picks a box centred in the screen (16:9, the whole screen or 4:3);
+// scaling puts the picture in it whole with bars (Fit), filled out of shape (Stretch) or filled and cut at the box's edges (Zoom)
+static CGRect g_game_rect;   // the picture's rectangle in the root view (DmGamepad.m maps the game's touch screen onto it)
+CGRect front_ios_game_rect(void) { return g_game_rect; }
+static void game_layout(CGRect b, CGRect *box, CGRect *pic) {
+    const char *a = getenv("DM_IOS_ASPECT"), *sc = getenv("DM_IOS_SCALING");
+    CGFloat r = a && !strcmp(a, "screen") ? b.size.width / b.size.height : a && !strcmp(a, "43") ? 4.0 / 3.0 : 16.0 / 9.0;
+    CGFloat w = b.size.width, h = b.size.height;
+    if (w / h > r) w = h * r; else h = w / r;
+    *box = CGRectMake(floor((b.size.width - w) / 2), floor((b.size.height - h) / 2), w, h);
+    CGFloat pw = w, ph = h;   // Stretch: the box itself
+    if (!sc || strcmp(sc, "stretch")) {
+        int zoom = sc && !strcmp(sc, "zoom");
+        if ((w / h > 16.0 / 9.0) != zoom) pw = h * 16.0 / 9.0; else ph = w * 9.0 / 16.0;   // Fit: inside the box; Zoom: covering it
+    }
+    *pic = CGRectMake(round((w - pw) / 2), round((h - ph) / 2), pw, ph);   // in the box
+}
