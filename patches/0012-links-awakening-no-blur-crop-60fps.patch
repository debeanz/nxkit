+// nxkit: profile key keep_60 (Link's Awakening): the game asks for interval 2 after a few late frames and then stays at 30 fps, as the phone moves it to the efficiency cores and lowers the
+// GPU clock for the slower pace (GPU time 9.6 → 21 ms a frame). Its interval 2 is not taken: the window keeps 1, which the game reads back every frame. DM_KEEP_60=0 follows the game again
+static int keep_60(void) { static int v = -1; if (v < 0) { const char *e = getenv("DM_KEEP_60"); v = e && *e ? atoi(e) != 0 : DM_GAME_KEEP_60; if (v) LOG("[nvn] keep 60 fps: the game's present interval 2 is not followed (profile key keep_60; DM_KEEP_60=0 follows it)"); } return v; }
+NVN(nvnWindowSetPresentInterval, void, NVNwindow *w, int v) {
+    if (v > 1 && keep_60()) { static uint64_t n; if (n++ < 3 || n % 1000 == 0) LOG("[nvn] the game asks for present interval %d: kept at 1 (%llu times)", v, (unsigned long long)n); v = 1; }
+    if (((win_t *)w)->interval != v) LOG("[nvn] the game sets present interval %d → %d", ((win_t *)w)->interval, v); ((win_t *)w)->interval = v; }
