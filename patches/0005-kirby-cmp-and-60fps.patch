+    (0x533d00, '692640b9', '29008052', 'frame pacer wait, mode 1: ldr w9,[x19,#0x24] → mov w9,#1'),
+    (0x533d14, '693e40b9', '29008052', 'frame pacer wait, mode 2: ldr w9,[x19,#0x3c] → mov w9,#1'),
