+    pthread_mutex_lock(&g_rec_mu);
+    for (;;) {
+        int i = 0; while (i < g_nrec && g_rec[i].o != o) i++;
+        if (i == g_nrec) { if (g_nrec < REC_MAX) { g_rec[g_nrec].o = o; g_rec[g_nrec].t = me; g_nrec++; } break; }
+        if (pthread_equal(g_rec[i].t, me)) break;   // this thread again: a recording it never ended
+        if (!waited) { waited = 1; t0 = now_ns(); clock_gettime(CLOCK_REALTIME, &until); until.tv_sec += REC_WAIT_S; }
+        if (pthread_cond_timedwait(&g_rec_cv, &g_rec_mu, &until)) { g_rec[i].t = me; gave_up = 1; break; }
