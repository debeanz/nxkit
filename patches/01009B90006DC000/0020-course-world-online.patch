+// ---- user records (0x1f0 bytes in the user ring at NetObj +0x68)
+static void user_reset(uint64_t e) {
+    if (g64(e + 0x08)) s16(g64(e + 0x08), 0);
+    if (g64(e + 0x30)) s16(g64(e + 0x30), 0);
+    s64(e + 0x58, 0);
+    if (g64(e + 0x68)) s8(g64(e + 0x68), 0);
+    s16(e + 0x80, 0xff);
+    for (uint64_t o = 0x88; o < 0x168; o += 8) s64(e + o, 0);
+    s8(e + 0x168, 0);
+    for (int i = 0; i < 29; i++) s8(e + 0x169 + i, i % 3 == 0);
+    for (uint64_t o = 0x188; o < 0x1a8; o += 8) s64(e + o, 0);
+    if (g64(e + 0x1b0)) s8(g64(e + 0x1b0), 0);
+    s32(e + 0x1e8, 0);
+    s8(e + 0x1ec, 0);
+}
+static void fill_user(uint64_t e, uint64_t pid, const char *maker_id, const char *name, J *prof) {
+    uint32_t likes = 0, points = 0;
+    J *cs = jget(prof, "courses");
+    for (int i = 0; i < jlen(cs); i++) {
+        int32_t l = (int32_t)jnum(jget(jat(cs, i), "likes"), 0), b = (int32_t)jnum(jget(jat(cs, i), "boos"), 0);
+        likes += (uint32_t)l; points += l > b ? (uint32_t)(l - b) : 0;
+    }
+    const char *nm = jstr(jget(jget(prof, "maker"), "name"), name && *name ? name : "Maker");
+    char code[12] = "";
+    if (maker_id && strlen(maker_id) == 11) snprintf(code, sizeof code, "%.3s%.3s%.3s", maker_id, maker_id + 4, maker_id + 8);
+    user_reset(e);
+    put16(g64(e + 0x08), g32(e + 0x10), code);   // maker code (no dashes)
+    put16(g64(e + 0x30), g32(e + 0x38), nm);
+    s64(e + 0x58, pid);
+    s8(e + 0x98, 1);   // comments on
+    default_mii(e + 0x9c, nm);
+    s32(e + 0x124, likes); s32(e + 0x128, points);
+    s32(e + 0x190, (uint32_t)jlen(cs)); s32(e + 0x194, 100);   // courses uploaded, the most allowed
+    s8(e + 0x1ec, 1);   // a registered Course World user
+}
+
+// ---- thumbnails (0x1c000-byte blocks): JPEG at +0, its size at +0x1bf9c, HMAC-SHA256 at +0x1bfa0 under a key from the seed words at +0x1bfc0,
+// signed with the game's own functions as its blank thumbnail is; the game checks it (and deletes a downloaded course with a failing one)
+#define THUMB_BLOCK 0x1c000
+static int sign_jpeg(uint64_t dst, uint32_t size, const uint8_t *jpeg, size_t len) {
+    if (!len || len > size - 0x64) return 0;
+    uint64_t tail = dst + size - 0x64;
+    memset((void *)(uintptr_t)dst, 0, size);
+    memcpy((void *)(uintptr_t)dst, jpeg, len);
+    s32(tail, (uint32_t)len);
+    uint8_t *w = calloc(1, 0x100);   // RNG state +0, key +0x80, key table holder +0xc0
+    uint64_t st = (uint64_t)(uintptr_t)w, key = st + 0x80, table = st + 0xc0;
+    game_call(F_RNG_INIT, st, 0, 0, 0, 0, 0);
+    game_call(F_RNG_SEEDS, st, tail + 0x24, tail + 0x28, tail + 0x2c, tail + 0x30, 0);
+    s64(table, M(K_THUMB_KEYS));
+    game_call(F_THUMB_KEY, table, key, st, 0, 0, 0);
+    game_call(F_HMAC, tail + 4, 0x20, dst, len, key, 0x10);
+    free(w);
+    return 1;
+}
+// A 640 x 360 picture of one colour (baseline JPEG, one 8x8 block per component and MCU, DC only) for a course without a picture
+typedef struct { uint8_t *p; size_t n, cap; uint32_t acc; int bits; } Bits;
+static void b8(Bits *b, uint8_t v) { if (b->n < b->cap) b->p[b->n++] = v; }
+static void b16(Bits *b, unsigned v) { b8(b, (uint8_t)(v >> 8)); b8(b, (uint8_t)v); }
+static void bits(Bits *b, uint32_t code, int len) {
+    while (len--) {
+        b->acc = b->acc << 1 | (code >> len & 1);
+        if (++b->bits == 8) { b8(b, (uint8_t)b->acc); if ((b->acc & 0xff) == 0xff) b8(b, 0); b->acc = 0; b->bits = 0; }
+    }
+}
+static size_t plain_jpeg(uint8_t *out, size_t cap, int w, int h, int r, int g, int bl) {
+    Bits b = {out, 0, cap, 0, 0};
+    int dc[3] = {(int)(0.299 * r + 0.587 * g + 0.114 * bl + 0.5) - 128, (int)(128 - 0.168736 * r - 0.331264 * g + 0.5 * bl + 0.5) - 128,
+                 (int)(128 + 0.5 * r - 0.418688 * g - 0.081312 * bl + 0.5) - 128};   // with every quantizer 8 the DC coefficient is the level-shifted value
+    b16(&b, 0xFFD8);
+    b16(&b, 0xFFE0); b16(&b, 16); { const char *j = "JFIF"; for (int i = 0; i < 5; i++) b8(&b, (uint8_t)j[i]); } b16(&b, 0x0101); b8(&b, 0); b16(&b, 1); b16(&b, 1); b8(&b, 0); b8(&b, 0);
+    b16(&b, 0xFFDB); b16(&b, 67); b8(&b, 0); for (int i = 0; i < 64; i++) b8(&b, 8);
+    b16(&b, 0xFFC0); b16(&b, 17); b8(&b, 8); b16(&b, (unsigned)h); b16(&b, (unsigned)w); b8(&b, 3);
+    for (int c = 1; c <= 3; c++) { b8(&b, (uint8_t)c); b8(&b, 0x11); b8(&b, 0); }
+    static const uint8_t dc_counts[16] = {0, 1, 5, 1, 1, 1, 1, 1, 1};   // the standard luminance DC table (categories 0..11)
+    b16(&b, 0xFFC4); b16(&b, 2 + 17 + 12 + 17 + 1);
+    b8(&b, 0x00); for (int i = 0; i < 16; i++) b8(&b, dc_counts[i]); for (int i = 0; i < 12; i++) b8(&b, (uint8_t)i);
+    b8(&b, 0x10); b8(&b, 1); for (int i = 1; i < 16; i++) b8(&b, 0); b8(&b, 0x00);   // AC table: one code, end of block ("0")
+    b16(&b, 0xFFDA); b16(&b, 12); b8(&b, 3); for (int c = 1; c <= 3; c++) { b8(&b, (uint8_t)c); b8(&b, 0); } b8(&b, 0); b8(&b, 63); b8(&b, 0);
+    static const uint16_t code[12] = {0x0, 0x2, 0x3, 0x4, 0x5, 0x6, 0xe, 0x1e, 0x3e, 0x7e, 0xfe, 0x1fe};
+    static const uint8_t clen[12] = {2, 3, 3, 3, 3, 3, 4, 5, 6, 7, 8, 9};
+    for (int mcu = 0, n = ((w + 7) / 8) * ((h + 7) / 8); mcu < n; mcu++)
+        for (int c = 0; c < 3; c++) {
+            int d = mcu ? 0 : dc[c], a = d < 0 ? -d : d, cat = 0;
+            while (a >> cat) cat++;
+            bits(&b, code[cat], clen[cat]);
+            if (cat) bits(&b, (uint32_t)(d < 0 ? d - 1 : d) & ((1u << cat) - 1), cat);
+            bits(&b, 0, 1);   // end of block
+        }
+    if (b.bits) bits(&b, 0xff, 8 - b.bits);
+    b16(&b, 0xFFD9);
+    return b.n < cap ? b.n : 0;
+}
+static int stand_in_thumbnail(uint64_t dst) {
+    static uint8_t jpeg[0x4000]; static size_t len;
+    if (!len) len = plain_jpeg(jpeg, sizeof jpeg, 640, 360, 0xb4, 0xc8, 0xdc);
+    return sign_jpeg(dst, THUMB_BLOCK, jpeg, len);
+}
+static int server_thumbnail(uint64_t id, uint64_t dst, int wait_ms) {   // 1: the server's picture is in dst; 0: none (yet)
+    char code[12], path[128];
+    code_of((uint32_t)id, code);
+    snprintf(path, sizeof path, "/api/courses/%s/thumbnail?wait_ms=%d&soon_ms=1500", code, wait_ms);
+    Resp r;
+    int st = http("GET", path, NULL, wait_ms + 6000, &r);
+    int ok = st == 200 && sign_jpeg(dst, THUMB_BLOCK, (const uint8_t *)r.body, r.len);
+    free(r.body);
+    return ok;
+}
