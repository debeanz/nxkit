+static J *maker_get(const char *id) {   // GET /api/makers/<XXX-XXX-XXX>
+    if (!id || strlen(id) != 11 || id[3] != '-' || id[7] != '-') return NULL;
+    char path[64]; snprintf(path, sizeof path, "/api/makers/%s", id);
+    return srv_json("GET", path, NULL, 10000, NULL);
+}
+
+static void w_search(uint64_t *regs) {   // SearchCourses: Course World's lists (type at +0x746e8; 14 is the Endless Challenge, not served)
+    uint64_t no = regs[0];
+    uint32_t type = g32(no + 0x746e8), page = g32(no + 0x737a8), band = 4, style = 5;
+    const char *sort = "popular", *list_kind = NULL;
+    int by_maker = 0, none = 0;
+    char id[16] = "", name[48], path[256];
+    switch (type) {
+    case 0: sort = "hot"; break;
+    case 1: band = g32(no + 0x746ec); break;   // Popular, by difficulty
+    case 2: sort = "new"; break;
+    case 4: band = g32(no + 0x746fc); style = g8(no + 0x74704); if (g32(no + 0x7470c) == 1) sort = "new"; break;   // Detailed Search
+    case 5: break;
+    case 6: case 8: case 9: by_maker = 1; break;   // a maker's courses, world records, first clears
+    case 7: list_kind = "liked"; break;
+    case 10: list_kind = "played"; break;
+    default: none = 1; break;   // followed makers, versus, the Endless Challenge
+    }
+    if (by_maker || list_kind) maker_of(g64(no + 0x746f0), id, name);
+    J *j = NULL;
+    if (by_maker) j = maker_get(id);
+    else if (list_kind && *id && page == 0) { snprintf(path, sizeof path, "/api/makers/%s/%s", id, list_kind); j = srv_json("GET", path, NULL, 10000, NULL); }
+    else if (!none && !list_kind) {
+        snprintf(path, sizeof path, "/api/courses?sort=%s&offset=%u&limit=100%s%s", sort, page * 100, style < 5 ? "&style=" : "", style < 5 ? STYLES[style] : "");
+        j = srv_json("GET", path, NULL, 15000, NULL);
+    }
+    J *list = jget(j, "courses");
+    lock(no);
+    uint32_t n = courses_into_ring(no, list, band, type == 8 ? id : NULL, type == 9 ? id : NULL);
+    s8(no + 0x737ac, !none && !by_maker && !list_kind && jlen(list) >= 100);   // a next page follows
+    unlock(no);
+    LOG("smm2 online: course list (type %u, page %u%s%s): %u courses", type, page, *id ? ", maker " : "", id, n);
+    int ok = none || by_maker || list_kind || j;
+    jfree(j);
+    finish(regs, no, ok, 2);
+}
+
+static void w_by_code(uint64_t *regs) {   // GetUserOrCourse: a course (or a maker) by its ID, typed in at +0x74728
+    uint64_t no = regs[0];
+    char raw[40], bare[16], dashed[16], path[64];
+    get16(g64(no + 0x74728), raw, sizeof raw);
+    size_t k = 0;
+    for (const char *p = raw; *p && k < 9; p++) if (*p != '-' && *p != ' ') bare[k++] = (char)toupper((unsigned char)*p);
+    bare[k] = 0;
+    snprintf(dashed, sizeof dashed, "%.3s-%.3s-%.3s", bare, bare + 3, bare + 6);
+    snprintf(path, sizeof path, "/api/courses/%s", dashed);
+    J *course = srv_json("GET", path, NULL, 15000, NULL);   // (the server looks it up at TGRCode, up to ~6 s)
+    J *maker = course ? NULL : maker_get(dashed);
+    uint32_t id;
+    lock(no);
+    s64(no + RING_COURSES + 0xc, 0); s64(no + RING_USERS + 0xc, 0);
+    if (course && id_of(dashed, &id) && g32(no + RING_COURSES + 8) && g64(no + RING_COURSES)) { fill_course(g64(no + RING_COURSES), course, id); s32(no + RING_COURSES + 0x10, 1); }
+    else if (maker && g32(no + RING_USERS + 8) && g64(no + RING_USERS)) {
+        const char *nm = jstr(jget(jget(maker, "maker"), "name"), "");
+        fill_user(g64(no + RING_USERS), maker_pid(dashed, nm), dashed, nm, maker); s32(no + RING_USERS + 0x10, 1);
+    }
+    unlock(no);
+    LOG("smm2 online: ID search %s: %s", dashed, course ? "a course" : maker ? "a maker" : "nothing");
+    jfree(course); jfree(maker);
+    finish(regs, no, 1, 0);
+}
