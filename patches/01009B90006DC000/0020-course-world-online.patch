+static void w_own_user(uint64_t *regs) {   // GetUsers for the player: their record, a registered user with a Mii
+    uint64_t no = regs[0];
+    own_maker_id();
+    lock(no);
+    s64(no + RING_USERS + 0xc, 0);
+    if (g32(no + RING_USERS + 8) > 0 && g64(no + RING_USERS)) {
+        uint64_t e = g64(no + RING_USERS);
+        user_reset(e);
+        char code[12] = "";
+        if (strlen(g_own_id) == 11) snprintf(code, sizeof code, "%.3s%.3s%.3s", g_own_id, g_own_id + 4, g_own_id + 8);
+        put16(g64(e + 0x08), g32(e + 0x10), code);
+        put16(g64(e + 0x30), g32(e + 0x38), g_nick);
+        s64(e + 0x58, OWN_PID);
+        default_mii(e + 0x9c, g_nick);
+        s32(e + 0x190, 0); s32(e + 0x194, 100);
+        s8(e + 0x1ec, 1);
+        s32(no + RING_USERS + 0x10, 1);
+    }
+    unlock(no);
+    // The Maker avatar: a name and a Mii in the save when it has none (else Course World sends the player to the console's Mii editor)
+    uint64_t set = g64(M(G_SETTINGS));
+    if (set && g64(set + 0x2b0) && *(volatile uint16_t *)(uintptr_t)g64(set + 0x2b0) == 0) { put16(g64(set + 0x2b0), 11, g_nick); LOG("smm2 online: Maker avatar named %s", g_nick); }
+    uint64_t us = g64(M(G_USER_SETTINGS)) ? g64(g64(M(G_USER_SETTINGS)) + 0x20) : 0;
+    if (us && !g64(us + 0x60) && !g64(us + 0x68)) { default_mii(us + 0x60, g_nick); LOG("smm2 online: Maker avatar Mii set to the default Mii"); }
+    finish(regs, no, 1, 0);
+}
