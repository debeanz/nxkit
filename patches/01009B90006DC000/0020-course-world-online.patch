+#define MAX_USERS 64
+static void users_answer(uint64_t *regs, uint64_t no, const uint64_t *pids, uint32_t n, int with_profiles) {
+    static __thread char ids[MAX_USERS][16], names[MAX_USERS][48];
+    J *prof[MAX_USERS] = {0};
+    if (n > MAX_USERS) n = MAX_USERS;
+    for (uint32_t i = 0; i < n; i++) {
+        maker_of(pids[i], ids[i], names[i]);
+        if (with_profiles && pids[i]) prof[i] = maker_get(ids[i]);   // (outside the lock: HTTP)
+    }
+    lock(no);
+    uint64_t ring = no + RING_USERS;
+    uint32_t cap = g32(ring + 8), m = 0;
+    s64(ring + 0xc, 0);
+    for (uint32_t i = 0; i < n && m < cap && g64(ring); i++)
+        if (pids[i]) fill_user(g64(ring) + (uint64_t)USER_ENTRY * m++, pids[i], ids[i], names[i], prof[i]);
+    s32(ring + 0x10, m);
+    unlock(no);
+    for (uint32_t i = 0; i < n; i++) jfree(prof[i]);
+    SLOG("users: %u", m);
+    finish(regs, no, 1, 0);
+}
+static void w_users_list(uint64_t *regs) {   // GetUsers for the players listed in the ring at +0x72b10 (u64 ids)
+    uint64_t no = regs[0], pids[MAX_USERS];
+    uint32_t n = 0;
+    lock(no);
+    uint64_t req = no + 0x72b10;
+    uint32_t cap = g32(req + 8), head = g32(req + 0xc), count = g32(req + 0x10);
+    for (uint32_t i = 0; i < count && cap && n < MAX_USERS && g64(req); i++) pids[n++] = g64(g64(req) + 8ull * ((head + i) % cap));
+    unlock(no);
+    users_answer(regs, no, pids, n, 0);
+}
+static void w_user_page(uint64_t *regs) { uint64_t no = regs[0], pid = g64(no + 0x73a30); users_answer(regs, no, &pid, 1, 1); }   // a maker's page
+static void w_user_counts(uint64_t *regs) { uint64_t no = regs[0]; lock(no); s64(no + 0x73a3c, 0); unlock(no); finish(regs, no, 1, 0); }
+
+static void w_courses_by_id(uint64_t *regs) {   // GetCourses: the records of the courses in the linked list at +0x74748 (after a play)
+    uint64_t no = regs[0], ids[64];
+    uint32_t n = 0;
+    lock(no);
+    uint64_t end = no + 0x74750, p = g64(no + 0x74758);
+    for (int guard = 0; p && p != end && guard < 256 && n < 64; guard++) { ids[n++] = g64(p - 8); p = g64(p + 8); }
+    unlock(no);
+    J *metas[64] = {0};
+    for (uint32_t i = 0; i < n; i++) {
+        char code[12], path[64];
+        code_of((uint32_t)ids[i], code);
+        snprintf(path, sizeof path, "/api/courses/%s", code);
+        metas[i] = srv_json("GET", path, NULL, 10000, NULL);
+    }
+    lock(no);
+    uint64_t ring = no + RING_COURSES;
+    uint32_t cap = g32(ring + 8), count = 0;
+    s64(ring + 0xc, 0);
+    for (uint32_t i = 0; i < n && count < cap && g64(ring); i++) if (metas[i]) fill_course(g64(ring) + (uint64_t)COURSE_ENTRY * count++, metas[i], (uint32_t)ids[i]);
+    s32(ring + 0x10, count);
+    unlock(no);
+    for (uint32_t i = 0; i < n; i++) jfree(metas[i]);
+    finish(regs, no, count > 0 || n == 0, 2);
+}
+
+// GetObject: a course's file (data id +0x8e5f0) into the buffer at +0x8e5e8: {u32 1, u16 0x10, u16 0, u32 CRC32 of the course, "SCDL"}, then the
+// course (0x5bfc0 bytes) encrypted with the game's own course encryption, then its 0x30-byte block (IV, seed, CMAC). The server gives it plain
+#define COURSE_SIZE 0x5bfc0
+static uint32_t crc32(const uint8_t *p, size_t n) {
+    uint32_t c = 0xFFFFFFFFu;
+    while (n--) { c ^= *p++; for (int k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320u ^ (c >> 1) : c >> 1; }
+    return ~c;
+}
+static void w_course_file(uint64_t *regs) {
+    uint64_t no = regs[0], id = g64(no + 0x8e5f0), dest = g64(no + 0x8e5e8);
+    char code[12], path[96];
+    code_of((uint32_t)id, code);
+    snprintf(path, sizeof path, "/api/courses/%s/data?wait_ms=20000", code);   // (a listed TGRCode course is fetched first: TGRCode allows about one request in 6 s)
+    Resp r;
+    int st = http("GET", path, NULL, 26000, &r);
+    if (st != 200 || r.len != COURSE_SIZE || !dest) {
+        LOG("smm2 online: course %s: %s (HTTP %d, %zu bytes)", code, st == 200 ? "not a course" : "download failed", st, r.len);
+        free(r.body);
+        finish(regs, no, 0, st == 200 ? 2 : 7);
+        return;
+    }
+    static uint8_t *plain; static uint64_t *keyholder;
+    if (!plain) { plain = malloc(COURSE_SIZE); keyholder = malloc(16); }
+    memcpy(plain, r.body, COURSE_SIZE);
+    free(r.body);
+    keyholder[0] = M(K_COURSE_KEYS);
+    uint32_t crc = crc32(plain, COURSE_SIZE);
+    game_call(F_ENCRYPT, (uint64_t)(uintptr_t)keyholder, dest + 0x10 + COURSE_SIZE, COURSE_SIZE, dest + 0x10, (uint64_t)(uintptr_t)plain, 0);
+    s32(dest, 1); s16(dest + 4, 0x10); s16(dest + 6, 0); s32(dest + 8, crc); memcpy((void *)(uintptr_t)(dest + 0xc), "SCDL", 4);
+    LOG("smm2 online: course %s downloaded", code);
+    finish(regs, no, 1, 0);
+}
+
+static void w_thumbnails(uint64_t *regs) {   // the pictures of the courses in the ring at +0x74bc8 (0x1a8-byte entries, data id at +0) into *(+0x8e608)[i]
+    uint64_t no = regs[0], ids[8], outs[8];
+    uint32_t n = 0;
+    lock(no);
+    uint64_t ring = no + 0x74bc8, entries = g64(ring), out = g64(no + 0x8e608), downloading = g64(no + 0x8e5f0);
+    uint32_t cap = g32(ring + 8), head = g32(ring + 0xc), count = g32(ring + 0x10), nout = g32(no + 0x8e600);
+    for (uint32_t i = 0; i < count && cap && entries && n < 8; i++) {
+        uint64_t o = i < nout && out ? g64(out + 8ull * i) : 0;
+        if (o) ids[n] = g64(entries + 0x1a8ull * ((head + i) % cap)), outs[n++] = o;
+    }
+    s32(no + 0x60, 0);
+    unlock(no);
+    uint32_t got = 0;
+    for (uint32_t i = 0; i < n; i++) {   // (what the server holds now; one being downloaded is waited for, or gets a stand-in, which the Coursebot needs)
+        int dl = ids[i] == downloading;
+        if (server_thumbnail(ids[i], outs[i], dl ? 7000 : 0)) { got++; continue; }
+        if (dl && stand_in_thumbnail(outs[i])) continue;
+        s32(outs[i] + 0x1bf9c, 0);   // none: the game's placeholder
+    }
+    SLOG("pictures: %u of %u", got, n);
+    regs[0] = g8(M(G_OK_BYTE));
+}
+
+// cDownload (main+0x17661f0, observation gate): a Download whose picture failed with the list (the server did not have it yet) waits in state 3
+// (+0x244) on the course's thumbnail cache slot (profile +0x132858, 0x1c1b8-byte slots: block, +0x1c000 data id, +0x1c1b2 failed, +0x1c1b4 valid),
+// whose failed mark the cache never clears: the mark goes and the slot gets the server's picture or the stand-in through the game's cache function
+static void obs_download(const uint64_t *regs) {
+    uint64_t self = regs[0], id;
+    if (!g_on || g32(self + 0x244) != 3 || !(id = g64(self + 600))) return;
+    uint64_t profile = g64(M(G_PROFILE)), slots = profile ? g64(profile + 0x132858) : 0;
+    uint32_t n = profile ? g32(profile + 0x132850) : 0;
+    for (uint32_t i = 0; i < n && i < 100 && slots; i++) {
+        uint64_t slot = slots + 0x1c1b8ull * i;
+        if (g64(slot + 0x1c000) != id) continue;
+        if (!g8(slot + 0x1c1b2)) return;
+        s8(slot + 0x1c1b2, 0);
+        if (g8(slot + 0x1c1b4)) return;
+        int real = server_thumbnail(id, slot, 0);
+        if (!real && !stand_in_thumbnail(slot)) return;
+        game_call(F_THUMB_CACHE_PUT, profile, slot, id, 0, 0, 0);
+        LOG("smm2 online: Download: the course's picture again (%s): %s", real ? "the server's" : "a stand-in", g8(slot + 0x1c1b4) ? "valid" : "rejected");
+        return;
+    }
+}
+
+static void w_play_result(uint64_t *regs) {   // PostPlayResult: a play (and a clear with its time) for the server's counts
+    uint64_t no = regs[0], id = g64(no + 0x8e618);
+    uint32_t cleared = g32(no + 0x8e620), ms = g32(no + 0x8e624);
+    char code[12], path[64], body[48];
+    code_of((uint32_t)id, code);
+    snprintf(path, sizeof path, "/api/courses/%s/play", code); jfree(srv_json("POST", path, "{}", 5000, NULL));
+    if (cleared == 1) { snprintf(path, sizeof path, "/api/courses/%s/clear", code); snprintf(body, sizeof body, "{\"time_ms\":%u}", ms); jfree(srv_json("POST", path, body, 5000, NULL)); }
+    LOG("smm2 online: played %s%s", code, cleared == 1 ? " (cleared)" : "");
+    finish(regs, no, 1, 0);
+}
+static void w_can_rate(uint64_t *regs) {   // CanPostRatingAndComment: rating open, two comment allowances
+    uint64_t no = regs[0], id = g64(no + 0xe8578);
+    lock(no);
+    for (int i = 0; i < 2; i++) { uint64_t r = no + (i ? 0xe8530 : 0xe8580); s64(r, id); s8(r + 8, 0); s32(r + 0xc, 0); s16(r + 0x10, i ? 0x0a0a : 0); s8(r + 0x12, 1); }
+    unlock(no);
+    finish(regs, no, 1, 0);
+}
+static void w_rate(uint64_t *regs) {   // PostRatingInfo: 1 like, 2 boo, 0 taken back
+    uint64_t no = regs[0], id = g64(no + 0xe8548);
+    uint32_t a = g32(no + 0xe8550);
+    char code[12], path[64];
+    code_of((uint32_t)id, code);
+    J *j = NULL;
+    if (a == 1 || a == 2) { snprintf(path, sizeof path, "/api/courses/%s/%s", code, a == 1 ? "like" : "boo"); j = srv_json("POST", path, "{}", 5000, NULL); }
+    else if (a == 0) { snprintf(path, sizeof path, "/api/courses/%s/vote", code); j = srv_json("DELETE", path, NULL, 5000, NULL); }
+    finish(regs, no, j != NULL || a > 2, 2);
+    jfree(j);
+}
+static void w_comments(uint64_t *regs) {   // SearchComments (while a course plays): none
+    uint64_t no = regs[0];
+    lock(no);
+    s64(no + 0x8f41c, 0); s32(no + 0xe8528, g32(no + 0x737a8)); s8(no + 0xe852c, g8(no + 0x737ac)); s8(no + 0xe852d, 1);
+    unlock(no);
+    finish(regs, no, 1, 0);
+}
+// Answers with nothing to fetch: a few writes under the lock, then success
+#define TRIVIAL(name, body) static void name(uint64_t *regs) { uint64_t no = regs[0]; lock(no); body; unlock(no); finish(regs, no, 1, 0); }
+TRIVIAL(w_ok, USE(no))                                                           // LoginCheck, UpdateLastLoginInfo, PostActivityQuest, SyncUserProfile, ReportFromBugDetection
+TRIVIAL(w_app_config, for (int i = 0; i < 38; i++) s32(no + 0x737b0 + 4 * i, 0)) // GetApplicationConfig: nothing switched on (no Endless Challenge, no Super Worlds)
+TRIVIAL(w_name_ok, s32(no + 0x141608, 0))                                        // GetUserNameNgType: the name is fine
+TRIVIAL(w_no_clothes, s32(no + 0x73a58, 0))                                      // GetMiiClothes: no costume rewards
+TRIVIAL(w_no_news, s8(no + 0xeac12, 0); s8(no + 0xeac14, 0))                     // GetNewNotification
+TRIVIAL(w_no_event, s64(no + 0x1a0810, 0); s8(no + 0x1a0818, 0); s64(no + 0x1a0820, 0); s8(no + 0x1a0828, 0))   // GetEventCourseStatus
+TRIVIAL(w_no_events, s32(no + 0x1a0808, 0))                                      // Ninji Speedruns: no events
+TRIVIAL(w_no_event_list, s64(no + 0x14161c, 0))
+TRIVIAL(w_course_info, s64(no + 0xe85ac, 0))                                     // records about a course around its start: none
+TRIVIAL(w_id_check, s32(no + 0x141604, 0))                                       // a check on an id: passes
+
+static const struct { uint32_t off; void (*fn)(uint64_t *); const char *what; } k_wrappers[] = {
+    {0x60fe20, w_login_ready, "cLogInReady"}, {0x6101d0, w_login, "cLogIn"},
+    {0x14ce2f0, w_app_config, "GetApplicationConfig"}, {0x14d5cd0, w_own_user, "GetUsers (own)"}, {0x14f2cc0, w_name_ok, "GetUserNameNgType"},
+    {0x14cef40, w_ok, "SyncUserProfile"}, {0x14d8360, w_no_clothes, "GetMiiClothes"}, {0x14d7d20, w_ok, "LoginCheck"}, {0x14d7e00, w_ok, "UpdateLastLoginInfo"},
+    {0x14f0b30, w_ok, "PostActivityQuest"}, {0x14edee0, w_no_news, "GetNewNotification"}, {0x14f3ab0, w_no_event, "GetEventCourseStatus"},
+    {0x14f3980, w_no_events, "GetEventCourseCount"}, {0x14f3770, w_no_event_list, "GetEventCourses"},
+    {0x14d8550, w_search, "SearchCourses"}, {0x14dc0d0, w_by_code, "GetUserOrCourse"}, {0x14d02d0, w_users_list, "GetUsers (list)"},
+    {0x14d7780, w_users_list, "GetUsers (list 2)"}, {0x14d2f00, w_user_page, "GetUsers (maker page)"}, {0x14d74a0, w_user_counts, "GetUsers (counts)"},
+    {0x14dbae0, w_courses_by_id, "GetCourses"}, {0x14de010, w_course_file, "GetObject (course)"}, {0x14e0e70, w_thumbnails, "pictures"},
+    {0x14ec0d0, w_course_info, "course records"}, {0x14f17a0, w_id_check, "id check"}, {0x14e8ec0, w_comments, "SearchComments"},
+    {0x14e30e0, w_play_result, "PostPlayResult"}, {0x14ebc60, w_can_rate, "CanPostRatingAndComment"}, {0x14e6b90, w_rate, "PostRatingInfo"},
+    {0x14f2910, w_ok, "ReportFromBugDetection"},
+};
+
+static void init(void) {
+    for (int i = 0; i < g_nmod; i++)
+        if (!strcmp(g_mod[i].name, "main")) { g_main = g_mod[i].base; g_ro_off = g_mod[i].ro_off; g_data_off = g_mod[i].data_off; }
+    const char *e = getenv("DM_SMM2_ONLINE");
+    g_log = getenv("DM_SMM2_LOG") && atoi(getenv("DM_SMM2_LOG"));
+    if (!g_main || strcmp(dm_main_build(), SMM2_BUILD)) { LOG("smm2 online: off (main is not Super Mario Maker 2 3.0.3)"); return; }
+    if (e && !atoi(e)) { LOG("smm2 online: off (DM_SMM2_ONLINE=0)"); return; }
+    const char *nick = getenv("DM_NICK");
+    if (nick && *nick) snprintf(g_nick, sizeof g_nick, "%s", nick);
+    g_on = 1;
+    gate_obs_set(OBS_SMM2_DOWNLOAD, obs_download);
+    pthread_attr_t a; pthread_attr_init(&a); pthread_attr_setstacksize(&a, 8 << 20);   // (the server's own start: Rust, on a big stack)
+    pthread_t t;
+    if (pthread_create(&t, &a, srv_start, NULL)) srv_set(-1); else pthread_detach(t);
+    pthread_attr_destroy(&a);
+    LOG("smm2 online: on (Course World from the course server; DM_SMM2_ONLINE=0 in env.txt turns it off)");
+}
+
+// The pretend-online switch nifm and account read (hle_net.c, hle_offline.c, hle_account.c): the network is up and the player has a network
+// service account, so the game opens Course World; its requests then come here
+int dm_online(void) { pthread_once(&g_once, init); return g_on; }
+uint64_t dm_online_account_id(void) { return OWN_PID; }
+
+// svc #0x8f, cut at the entry of each wrapper (patches.py): orig = its main offset
+uint64_t smm2_svc(uint64_t *regs, uint64_t orig) {
+    dm_online();
+    for (size_t i = 0; i < sizeof k_wrappers / sizeof *k_wrappers; i++) {
+        if (k_wrappers[i].off != orig) continue;
+        if (!g_on) {   // (switched off, nifm says offline and Course World does not open; a request that comes anyway fails as not connected)
+            if (k_wrappers[i].fn != w_login_ready && k_wrappers[i].fn != w_login) { s32(regs[0] + 0x60, 1); regs[0] = g8(M(G_FAIL_BYTE)); }
+            return 0;
+        }
+        SLOG("%s", k_wrappers[i].what);
+        k_wrappers[i].fn(regs);
+        return 0;
+    }
+    LOG("[RED] smm2 online: svc 0x8f at main+%#llx, which is no Course World request", (unsigned long long)orig);
+    return 0;
+}
