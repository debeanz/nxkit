+// ---- the wrappers
+#define USE(x) (void)(x)
+static void w_login_ready(uint64_t *regs) {   // enl session cLogInReady: logged in at once, no NEX login
+    uint64_t self = regs[0];
+    s8(self + 0x19, 1); s8(self + 0x1a, 0);
+    regs[0] = game_call(F_STATE_CHANGE, self + 0x30, 4, 0, 0, 0, 0);   // -> cLogIn
+    LOG("smm2 online: Course World session logged in (course server, no Nintendo network)");
+}
+static void w_login(uint64_t *regs) {   // cLogIn, the logged-in resting state: +0xe4 the command posted
+    uint64_t self = regs[0];
+    int32_t cmd = (int32_t)g32(self + 0xe4);
+    s8(self + 0x19, 1); s8(self + 0x1a, 0);
+    if (cmd == 0) regs[0] = game_call(F_STATE_CHANGE, self + 0x30, 0x1b, 0, 0, 0, 0);        // log out
+    else if (cmd == 0xf) regs[0] = game_call(F_STATE_CHANGE, self + 0x30, 0x1c, 0, 0, 0, 0); // log out and stop
+    else if (cmd != -1) { SLOG("session command %d done", cmd); s32(self + 0xe4, 0xffffffffu); }   // (matchmaking commands are dropped)
+}
