diff --git a/dm/host/hle_smm2_online.c b/dm/host/hle_smm2_online.c
new file mode 100644
index 00000000..85bf3c2c
--- /dev/null
+++ b/dm/host/hle_smm2_online.c
@@ -0,0 +1,896 @@
+// Super Mario Maker 2 3.0.3 (main c2dc405a…): Course World without Nintendo's servers (nxkit, patches/01009B90006DC000/0020).
+//
+// The game's Course World request functions ("wrappers": this = the network-session object, NetObj) are cut in the game's patches.py
+// to `svc #0x8f; ret`, so each call lands in smm2_svc below (hle_svc.c), which answers it the way the game's own converters would have
+// from a NEX answer and returns the byte the wrappers return for success or failure. The answers come from a course server on the
+// device: smm2recomp's (github.com/smm2recomp/smm2recomp, core/crates/embed, GPL-3.0), linked into the app when the build has it
+// (DM_SMM2_EMBED: nxkit's mac_build.sh builds it for iOS), which serves TGRCode's public course archive (tgrcode.com/mm2) at
+// 127.0.0.1. The structure offsets, the request functions and the game functions called back (the lock, the session's state change, the
+// course encryption, the thumbnail signing) are smm2recomp's findings for 3.0.3 (recomp/games/smm2/mods); this file is nxkit's own code.
+//
+// What it covers: Course World's login (no NEX connection), the course lists (Hot, Popular, New, Detailed Search, a maker's courses),
+// search by course ID, the makers on the lists, course downloads (play from the course page, Download to the Coursebot) and the
+// course pictures. Not covered (the game's own code answers "not connected"): the Endless Challenge, Super Worlds, uploads, comments,
+// leaderboards, Ninji Speedruns, multiplayer.
+//
+// Settings (Documents/env.txt): DM_SMM2_ONLINE=0 turns it off (the game is offline again); DM_SMM2_SERVER=<ip>:<port> and
+// DM_SMM2_TOKEN=<token> use a course server elsewhere instead of the one in the app; DM_SMM2_LOG=1 logs every request.
+#include "hle.h"
+#include <arpa/inet.h>
+#include <ctype.h>
+#include <errno.h>
+#include <netinet/in.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+
+#if DM_SMM2_EMBED
+uint16_t mmk_embed_start(const char *dir, const char *upstream, const uint8_t *image, size_t image_len, const char *name, char *token_out, size_t token_cap);
+#endif
+
+#define SMM2_BUILD "c2dc405ac414c37c8b1c50219c7a0f0c"
+#define OWN_PID 0x1234567890abcdefull   // the network service account id the host gives the player (hle_account.c), also their player id in the answers
+
+static uint8_t *g_main;            // main's base
+static uint64_t g_ro_off, g_data_off;
+static int g_on, g_log;
+static pthread_once_t g_once = PTHREAD_ONCE_INIT;
+
+#define SLOG(...) do { if (g_log) LOG("smm2 online: " __VA_ARGS__); } while (0)
+
+// ---- game memory (guest addresses are host addresses)
+#define M(off) ((uint64_t)(uintptr_t)g_main + (uint64_t)(off))
+static inline uint8_t g8(uint64_t a) { return *(volatile uint8_t *)(uintptr_t)a; }
+static inline uint32_t g32(uint64_t a) { return *(volatile uint32_t *)(uintptr_t)a; }
+static inline uint64_t g64(uint64_t a) { return *(volatile uint64_t *)(uintptr_t)a; }
+static inline void s8(uint64_t a, uint8_t v) { *(volatile uint8_t *)(uintptr_t)a = v; }
+static inline void s16(uint64_t a, uint16_t v) { *(volatile uint16_t *)(uintptr_t)a = v; }
+static inline void s32(uint64_t a, uint32_t v) { *(volatile uint32_t *)(uintptr_t)a = v; }
+static inline void s64(uint64_t a, uint64_t v) { *(volatile uint64_t *)(uintptr_t)a = v; }
+
+// A game function at a main offset, called on this (guest) thread; unused arguments are harmless in the AAPCS64
+typedef uint64_t (*game_fn)(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t);
+static uint64_t game_call(uint64_t off, uint64_t a, uint64_t b, uint64_t c, uint64_t d, uint64_t e, uint64_t f) {
+    return ((game_fn)(uintptr_t)M(off))(a, b, c, d, e, f);
+}
+
+#define F_LOCK 0x292410          // the wrappers' lock / unlock (x0: NetObj + 0x20)
+#define F_UNLOCK 0x292430
+#define F_STATE_CHANGE 0x8b9320  // (state machine, new state)
+#define F_ENCRYPT 0x8b3070       // the course encryption (key table holder, crypto block out, size, encrypted out, plain in)
+#define K_COURSE_KEYS 0x23d68c0  // its key table
+#define F_RNG_INIT 0x29a050      // thumbnail signing: (state)
+#define F_RNG_SEEDS 0x29a1c0     // (state, &w0, &w1, &w2, &w3)
+#define F_THUMB_KEY 0x168c6d0    // (&table, key out[16], state)
+#define K_THUMB_KEYS 0x23d6ed0
+#define F_HMAC 0x1cba7f0         // nn::crypto::GenerateHmacSha256Mac(mac, 32, data, size, key, 16)
+#define F_THUMB_CACHE_PUT 0x14b55b0   // (profile, block, data id)
+#define G_PROFILE 0x2c115e0
+#define G_OK_BYTE 0x2a17ad8      // the bytes the wrappers return: success, failure
+#define G_FAIL_BYTE 0x2a17ad9
+#define G_SETTINGS 0x2a57d60     // the player's settings: +0x2b0 the Maker avatar's name (UTF-16)
+#define G_USER_SETTINGS 0x2a39088   // *(...) +0x20: the save's user settings, CharInfo at +0x60
+
+static void lock(uint64_t no) { game_call(F_LOCK, no + 0x20, 0, 0, 0, 0, 0); }
+static void unlock(uint64_t no) { game_call(F_UNLOCK, no + 0x20, 0, 0, 0, 0, 0); }
+static void finish(uint64_t *regs, uint64_t no, int ok, uint32_t status) {   // status +0x60: 0 ok, 2 failed, 7 failed (the game retries once)
+    s32(no + 0x60, ok ? 0 : status);
+    regs[0] = g8(M(ok ? G_OK_BYTE : G_FAIL_BYTE));
+}
+
+// ---- strings: the game's UTF-16 buffers (their string objects own them; only the contents are written)
+static void put16(uint64_t buf, uint32_t cap, const char *s) {
+    if (!buf || !cap) return;
+    uint32_t n = 0;
+    for (const unsigned char *p = (const unsigned char *)(s ? s : ""); *p && n + 1 < cap;) {
+        uint32_t c = *p++;
+        int more = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : c >= 0xC0 ? 1 : 0;
+        if (more) { c &= 0x3F >> more; while (more-- && (*p & 0xC0) == 0x80) c = c << 6 | (*p++ & 0x3F); }
+        s16(buf + 2 * n++, c > 0xFFFF ? '?' : (uint16_t)c);
+    }
+    s16(buf + 2 * n, 0);
+}
+static void get16(uint64_t buf, char *out, size_t cap) {   // ASCII only (codes and ids)
+    size_t n = 0;
+    for (uint32_t i = 0; buf && n + 1 < cap; i++) {
+        uint16_t c = *(volatile uint16_t *)(uintptr_t)(buf + 2 * i);
+        if (!c) break;
+        out[n++] = c < 0x80 ? (char)c : '?';
+    }
+    out[n] = 0;
+}
+
+// ---- course codes <-> data ids (the public SMM2 course id scheme: base 30 digits, a check value, the id XORed with a constant)
+static const char CODE_DIGITS[] = "0123456789BCDFGHJKLMNPQRSTVWXY";
+#define CODE_XOR 0x1680E07Cull
+static void code_of(uint32_t id, char out[12]) {
+    uint64_t x = id ^ CODE_XOR, chk = ((uint64_t)id + 64 * 64 - 31) % 64;
+    uint64_t v = 8ull << 40 | chk << 34 | (x & 0xFFFFF) << 14 | 1ull << 12 | x >> 20;
+    char d[9];
+    for (int i = 0; i < 9; i++) d[i] = CODE_DIGITS[v % 30], v /= 30;
+    snprintf(out, 12, "%.3s-%.3s-%.3s", d, d + 3, d + 6);
+}
+static int id_of(const char *code, uint32_t *id) {
+    char d[9]; int n = 0;
+    for (const char *p = code; p && *p; p++) {
+        if (*p == '-' || *p == ' ') continue;
+        if (n == 9) return 0;
+        d[n++] = (char)toupper((unsigned char)*p);
+    }
+    if (n != 9) return 0;
+    uint64_t v = 0;
+    for (int i = 8; i >= 0; i--) {
+        const char *k = strchr(CODE_DIGITS, d[i]);
+        if (!k || !*k) return 0;
+        v = v * 30 + (uint64_t)(k - CODE_DIGITS);
+    }
+    if ((v >> 12 & 1) != 1 || (v >> 40 & 0xF) != 8) return 0;
+    uint64_t data = ((v & 0xFFF) << 20 | (v >> 14 & 0xFFFFF)) ^ CODE_XOR;
+    if ((v >> 34 & 0x3F) != (data + 64 * 64 - 31) % 64) return 0;
+    *id = (uint32_t)data;
+    return 1;
+}
+
+// ---- JSON (the server's answers)
+typedef struct J { char t; double num; char *str; int n, cap; char **keys; struct J **v; } J;   // t: o a s n b z (null)
+static void jfree(J *j) {
+    if (!j) return;
+    for (int i = 0; i < j->n; i++) { jfree(j->v[i]); if (j->keys) free(j->keys[i]); }
+    free(j->v); free(j->keys); free(j->str); free(j);
+}
+typedef struct { const char *p, *e; int depth; } JP;
+static void jws(JP *s) { while (s->p < s->e && (*s->p == ' ' || *s->p == '\t' || *s->p == '\n' || *s->p == '\r')) s->p++; }
+static char *jstring(JP *s) {   // at the opening quote
+    size_t cap = 32, n = 0; char *o = malloc(cap);
+    s->p++;
+    while (s->p < s->e && *s->p != '"') {
+        if (n + 8 > cap) o = realloc(o, cap *= 2);
+        char c = *s->p++;
+        if (c != '\\') { o[n++] = c; continue; }
+        if (s->p >= s->e) break;
+        c = *s->p++;
+        if (c == 'u' && s->e - s->p >= 4) {
+            unsigned u = 0;
+            for (int i = 0; i < 4; i++) { char h = s->p[i]; u = u << 4 | (unsigned)(h <= '9' ? h - '0' : (h | 32) - 'a' + 10); }
+            s->p += 4;
+            if (u >= 0xD800 && u < 0xDC00 && s->e - s->p >= 6 && s->p[0] == '\\' && s->p[1] == 'u') {   // surrogate pair
+                unsigned l = 0;
+                for (int i = 2; i < 6; i++) { char h = s->p[i]; l = l << 4 | (unsigned)(h <= '9' ? h - '0' : (h | 32) - 'a' + 10); }
+                if (l >= 0xDC00 && l < 0xE000) { u = 0x10000 + ((u - 0xD800) << 10) + (l - 0xDC00); s->p += 6; }
+            }
+            if (u < 0x80) o[n++] = (char)u;
+            else if (u < 0x800) o[n++] = (char)(0xC0 | u >> 6), o[n++] = (char)(0x80 | (u & 0x3F));
+            else if (u < 0x10000) o[n++] = (char)(0xE0 | u >> 12), o[n++] = (char)(0x80 | (u >> 6 & 0x3F)), o[n++] = (char)(0x80 | (u & 0x3F));
+            else o[n++] = (char)(0xF0 | u >> 18), o[n++] = (char)(0x80 | (u >> 12 & 0x3F)), o[n++] = (char)(0x80 | (u >> 6 & 0x3F)), o[n++] = (char)(0x80 | (u & 0x3F));
+        } else o[n++] = c == 'n' ? '\n' : c == 't' ? '\t' : c == 'r' ? '\r' : c == 'b' ? '\b' : c == 'f' ? '\f' : c;
+    }
+    if (s->p < s->e) s->p++;
+    o[n] = 0;
+    return o;
+}
+static J *jvalue(JP *s);
+static void jadd(J *j, char *key, J *v) {
+    if (j->n == j->cap) { j->cap = j->cap ? 2 * j->cap : 8; j->v = realloc(j->v, sizeof *j->v * j->cap); if (j->t == 'o') j->keys = realloc(j->keys, sizeof *j->keys * j->cap); }
+    if (j->t == 'o') j->keys[j->n] = key;
+    j->v[j->n++] = v;
+}
+static J *jvalue(JP *s) {
+    jws(s);
+    if (s->p >= s->e || ++s->depth > 40) return NULL;
+    J *j = calloc(1, sizeof *j);
+    char c = *s->p;
+    if (c == '{' || c == '[') {
+        j->t = c == '{' ? 'o' : 'a'; s->p++;
+        for (;;) {
+            jws(s);
+            if (s->p < s->e && *s->p == (j->t == 'o' ? '}' : ']')) { s->p++; break; }
+            char *key = NULL;
+            if (j->t == 'o') {
+                if (s->p >= s->e || *s->p != '"') goto bad;
+                key = jstring(s); jws(s);
+                if (s->p >= s->e || *s->p != ':') { free(key); goto bad; }
+                s->p++;
+            }
+            J *v = jvalue(s);
+            if (!v) { free(key); goto bad; }
+            jadd(j, key, v);
+            jws(s);
+            if (s->p < s->e && *s->p == ',') s->p++;
+        }
+    } else if (c == '"') { j->t = 's'; j->str = jstring(s); }
+    else if (c == 't' || c == 'f') { j->t = 'b'; j->num = c == 't'; s->p += c == 't' ? 4 : 5; }
+    else if (c == 'n') { j->t = 'z'; s->p += 4; }
+    else { char *end; j->t = 'n'; j->num = strtod(s->p, &end); if (end == s->p) goto bad; s->p = end; }
+    s->depth--;
+    return j;
+bad:
+    jfree(j);
+    return NULL;
+}
+static J *jparse(const char *t, size_t n) { JP s = {t, t + n, 0}; return t ? jvalue(&s) : NULL; }
+static J *jget(J *j, const char *k) { if (j && j->t == 'o') for (int i = 0; i < j->n; i++) if (!strcmp(j->keys[i], k)) return j->v[i]; return NULL; }
+static J *jat(J *j, int i) { return j && j->t == 'a' && i >= 0 && i < j->n ? j->v[i] : NULL; }
+static int jlen(J *j) { return j && j->t == 'a' ? j->n : 0; }
+static double jnum(J *j, double d) { return j && (j->t == 'n' || j->t == 'b') ? j->num : d; }
+static const char *jstr(J *j, const char *d) { return j && j->t == 's' ? j->str : d; }
+
+// ---- the course server: in the app (mmk_embed_start, started at the first network check) or DM_SMM2_SERVER
+static pthread_mutex_t g_srv_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t g_srv_cv = PTHREAD_COND_INITIALIZER;
+static int g_srv_state;            // 0 starting, 1 up, -1 none
+static struct sockaddr_in g_srv_addr;
+static char g_token[192], g_nick[48] = "Player";
+
+static void srv_set(int state) { pthread_mutex_lock(&g_srv_lock); g_srv_state = state; pthread_cond_broadcast(&g_srv_cv); pthread_mutex_unlock(&g_srv_lock); }
+static void *srv_start(void *arg) {
+    (void)arg;
+    const char *ext = getenv("DM_SMM2_SERVER");
+    memset(&g_srv_addr, 0, sizeof g_srv_addr);
+    g_srv_addr.sin_family = AF_INET;
+    if (ext && *ext) {
+        char host[64]; snprintf(host, sizeof host, "%s", ext);
+        char *colon = strrchr(host, ':');
+        int port = colon ? atoi(colon + 1) : 8640;
+        if (colon) *colon = 0;
+        if (inet_pton(AF_INET, host, &g_srv_addr.sin_addr) != 1) { LOG("[RED] smm2 online: DM_SMM2_SERVER %s is not <IPv4>:<port>", ext); srv_set(-1); return NULL; }
+        g_srv_addr.sin_port = htons((uint16_t)port);
+        snprintf(g_token, sizeof g_token, "%s", getenv("DM_SMM2_TOKEN") ? getenv("DM_SMM2_TOKEN") : "");
+        LOG("smm2 online: course server %s", ext);
+        srv_set(1);
+        return NULL;
+    }
+#if DM_SMM2_EMBED
+    char dir[1024];
+    snprintf(dir, sizeof dir, "%s/Documents/smm2-courses", getenv("HOME") ? getenv("HOME") : ".");
+    mkdir(dir, 0755);
+    // The course key table is found in the game's own data with the first download (the server scans main's .rodata for it, never stores it)
+    uint16_t port = mmk_embed_start(dir, "tgrcode", g_main + g_ro_off, (size_t)(g_data_off - g_ro_off), g_nick, g_token, sizeof g_token);
+    if (!port) { LOG("[RED] smm2 online: the course server in the app did not start"); srv_set(-1); return NULL; }
+    inet_pton(AF_INET, "127.0.0.1", &g_srv_addr.sin_addr);
+    g_srv_addr.sin_port = htons(port);
+    LOG("smm2 online: course server in the app at 127.0.0.1:%u (TGRCode's courses, data in %s)", port, dir);
+    srv_set(1);
+#else
+    LOG("[RED] smm2 online: this build has no course server (nxkit's mac_build.sh did not build it) and DM_SMM2_SERVER is not set: Course World stays empty");
+    srv_set(-1);
+#endif
+    return NULL;
+}
+static int srv_ready(int wait_ms) {
+    struct timespec until; clock_gettime(CLOCK_REALTIME, &until);
+    until.tv_sec += wait_ms / 1000; until.tv_nsec += (long)(wait_ms % 1000) * 1000000; if (until.tv_nsec >= 1000000000) until.tv_sec++, until.tv_nsec -= 1000000000;
+    pthread_mutex_lock(&g_srv_lock);
+    while (!g_srv_state) if (pthread_cond_timedwait(&g_srv_cv, &g_srv_lock, &until)) break;
+    int s = g_srv_state;
+    pthread_mutex_unlock(&g_srv_lock);
+    return s == 1;
+}
+
+// One HTTP/1.0 request (no chunked answers, the connection closes at the end) on the loopback socket. Returns the status (0: none came)
+typedef struct { int status; char *body; size_t len; } Resp;
+static int http(const char *method, const char *path, const char *body, int timeout_ms, Resp *r) {
+    memset(r, 0, sizeof *r);
+    if (!srv_ready(timeout_ms)) return 0;
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) return 0;
+    int one = 1; setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
+    struct timeval tv = {timeout_ms / 1000, (timeout_ms % 1000) * 1000};
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv); setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
+    if (connect(fd, (struct sockaddr *)&g_srv_addr, sizeof g_srv_addr)) { LOG("smm2 online: %s %s: no connection (errno %d)", method, path, errno); close(fd); return 0; }
+    size_t blen = body ? strlen(body) : 0;
+    char head[1024];
+    int hn = snprintf(head, sizeof head, "%s %s HTTP/1.0\r\nHost: 127.0.0.1\r\nUser-Agent: nxkit-smm2\r\n%s%s%s", method, path,
+                      *g_token ? "Authorization: Bearer " : "", g_token, *g_token ? "\r\n" : "");
+    if (body) hn += snprintf(head + hn, sizeof head - (size_t)hn, "Content-Type: application/json\r\nContent-Length: %zu\r\n\r\n", blen);
+    else hn += snprintf(head + hn, sizeof head - (size_t)hn, "\r\n");
+    if (hn <= 0 || (size_t)hn >= sizeof head) { close(fd); return 0; }
+    if (send(fd, head, (size_t)hn, 0) != hn || (blen && send(fd, body, blen, 0) != (ssize_t)blen)) { close(fd); return 0; }
+    size_t cap = 1 << 16, n = 0; char *buf = malloc(cap);
+    for (;;) {
+        if (cap - n < 1 << 14) buf = realloc(buf, cap *= 2);
+        ssize_t k = recv(fd, buf + n, cap - n - 1, 0);
+        if (k <= 0) break;
+        n += (size_t)k;
+    }
+    close(fd);
+    buf[n] = 0;
+    char *sep = strstr(buf, "\r\n\r\n");
+    if (strncmp(buf, "HTTP/", 5) || !sep) { free(buf); LOG("smm2 online: %s %s: no answer", method, path); return 0; }
+    r->status = atoi(strchr(buf, ' ') ? strchr(buf, ' ') + 1 : "0");
+    r->len = n - (size_t)(sep + 4 - buf);
+    r->body = malloc(r->len + 1);
+    memcpy(r->body, sep + 4, r->len); r->body[r->len] = 0;
+    free(buf);
+    SLOG("%s %s: %d, %zu bytes", method, path, r->status, r->len);
+    return r->status;
+}
+static J *srv_json(const char *method, const char *path, const char *body, int timeout_ms, int *status) {
+    Resp r;
+    int st = http(method, path, body, timeout_ms, &r);
+    if (status) *status = st;
+    J *j = st >= 200 && st < 300 ? jparse(r.body, r.len) : NULL;
+    if (st && (st < 200 || st >= 300) && st != 404) LOG("smm2 online: %s %s: HTTP %d %.160s", method, path, st, r.body ? r.body : "");
+    free(r.body);
+    return j;
+}
+
+// ---- makers: player ids for the makers of the courses served (the game compares ids for "my course"), back to their maker IDs and names
+#define NMAKERS 512
+static struct { uint64_t pid; char id[16], name[48]; } g_makers[NMAKERS];
+static int g_nmakers;
+static pthread_mutex_t g_mk_lock = PTHREAD_MUTEX_INITIALIZER;
+static char g_own_id[16];   // the player's maker ID on the course server (GET /api/me)
+
+static uint64_t maker_pid(const char *id, const char *name) {
+    if (!id) id = "";
+    if (*g_own_id && !strcmp(id, g_own_id)) return OWN_PID;
+    uint64_t h = 1469598103934665603ull;
+    for (const char *p = *id ? id : name ? name : ""; *p; p++) h = (h ^ (uint8_t)*p) * 1099511628211ull;
+    uint64_t pid = 0x5000000000000000ull | (h & 0xffffffffffffull) | 1;
+    pthread_mutex_lock(&g_mk_lock);
+    int i = 0;
+    while (i < g_nmakers && g_makers[i].pid != pid) i++;
+    if (i == g_nmakers) { i = g_nmakers < NMAKERS ? g_nmakers++ : (int)(pid % NMAKERS); g_makers[i].pid = pid; g_makers[i].name[0] = 0; }
+    snprintf(g_makers[i].id, sizeof g_makers[i].id, "%s", id);
+    if (name && *name) snprintf(g_makers[i].name, sizeof g_makers[i].name, "%s", name);
+    pthread_mutex_unlock(&g_mk_lock);
+    return pid;
+}
+static void maker_of(uint64_t pid, char id[16], char name[48]) {
+    id[0] = 0; snprintf(name, 48, "Maker");
+    if (pid == OWN_PID) { snprintf(id, 16, "%s", g_own_id); snprintf(name, 48, "%s", g_nick); return; }
+    pthread_mutex_lock(&g_mk_lock);
+    for (int i = 0; i < g_nmakers; i++)
+        if (g_makers[i].pid == pid) { snprintf(id, 16, "%s", g_makers[i].id); if (g_makers[i].name[0]) snprintf(name, 48, "%s", g_makers[i].name); break; }
+    pthread_mutex_unlock(&g_mk_lock);
+}
+static void own_maker_id(void) {   // once, from the server's local account
+    if (*g_own_id) return;
+    J *me = srv_json("GET", "/api/me", NULL, 8000, NULL);
+    snprintf(g_own_id, sizeof g_own_id, "%s", jstr(jget(me, "maker_id"), ""));
+    jfree(me);
+}
+
+// ---- a default Mii (nn::mii::CharInfo, 0x58 bytes): the player's Maker avatar and the makers' records. Course World asks for a new avatar
+// (the console's Mii editor) without a valid one. The face values are the console's first default Mii's (Ryujinx's DefaultMii table)
+static void default_mii(uint64_t out, const char *nick) {
+    static const uint8_t face[0x32] = {0, 0, 0, 64, 64, 0, 0, 0, 0, 0, 0, 33, 1, 0, 2, 8, 4, 3, 4, 2, 12, 6, 1, 4, 3, 6, 2, 10, 1, 4, 9,
+                                        23, 19, 4, 3, 13, 8, 0, 0, 4, 10, 0, 8, 4, 10, 0, 4, 2, 20, 0};
+    static const uint8_t create_id[16] = {'n', 'x', 'k', 'i', 't', 'M', 'i', 'i', 0x80, 1, 2, 3, 4, 5, 6, 7};   // (byte 8: the valid bits 10xxxxxx)
+    uint8_t *o = (uint8_t *)(uintptr_t)out;
+    memset(o, 0, 0x58);
+    memcpy(o, create_id, 16);
+    put16(out + 16, 11, nick && *nick ? nick : "Player");   // nickname: UTF-16, 10 characters
+    memcpy(o + 0x26, face, sizeof face);
+}
+
+// ---- course records (0x548 bytes in the course ring at NetObj +0x30780: entries, +8 capacity, +0xc head, +0x10 count)
+#define RING_COURSES 0x30780
+#define COURSE_ENTRY 0x548
+#define RING_USERS 0x68
+#define USER_ENTRY 0x1f0
+static const char *const STYLES[5] = {"M1", "M3", "MW", "WU", "3W"};
+static int style_of(const char *s) { for (int i = 0; i < 5; i++) if (s && !strcmp(s, STYLES[i])) return i; return 0; }
+static uint32_t band_of(J *m) { uint32_t v = (uint32_t)jnum(jget(m, "difficulty"), 50); return v < 35 ? 0 : v < 75 ? 1 : v < 96 ? 2 : 3; }
+
+static void fill_course(uint64_t e, J *m, uint32_t id) {
+    char code[12], bare[10];
+    code_of(id, code);
+    snprintf(bare, sizeof bare, "%.3s%.3s%.3s", code, code + 4, code + 8);   // (the game shows it with dashes)
+    s64(e + 0x000, id);
+    put16(g64(e + 0x010), g32(e + 0x018), bare);
+    s64(e + 0x030, maker_pid(jstr(jget(m, "maker_id"), ""), jstr(jget(m, "maker"), "")));
+    put16(g64(e + 0x040), g32(e + 0x048), jstr(jget(m, "name"), ""));
+    put16(g64(e + 0x098), g32(e + 0x0a0), jstr(jget(m, "description"), ""));
+    s8(e + 0x170, (uint8_t)style_of(jstr(jget(m, "style"), "")));
+    s8(e + 0x171, (uint8_t)jnum(jget(m, "theme"), 0));
+    s64(e + 0x178, (uint64_t)jnum(jget(m, "uploaded"), 0));
+    s32(e + 0x180, band_of(m));
+    // the player's own standing: +0x184 play state (1 not played, 2 played, 3 cleared), +0x188 rating (1 not played, 2 played, 3 liked, 4 booed)
+    J *you = jget(m, "you");
+    int vote = (int)jnum(jget(you, "vote"), 0), cleared = jnum(jget(you, "cleared"), 0) != 0, played = cleared || jnum(jget(you, "played"), 0) != 0;
+    s32(e + 0x184, !you ? 0 : cleared ? 3 : played ? 2 : 1);
+    s32(e + 0x188, !you ? 0 : vote > 0 ? 3 : vote < 0 ? 4 : played ? 2 : 1);
+    s32(e + 0x18c, 0); s8(e + 0x190, 0); s8(e + 0x191, 0);
+    for (uint64_t o = 0x194; o <= 0x1a4; o += 4) s32(e + o, 0);   // no clear condition
+    uint32_t stats[10] = {(uint32_t)jnum(jget(m, "plays"), 0), (uint32_t)jnum(jget(m, "attempts"), 0), 0, (uint32_t)jnum(jget(m, "clears"), 0), 0, 0, 0,
+                          (uint32_t)jnum(jget(m, "likes"), 0), 0, 0};   // plays, attempts, ?, clears, ..., likes
+    for (int i = 0; i < 10; i++) s32(e + 0x1a8 + 4 * i, stats[i]);
+    const char *fc = jstr(jget(m, "first_clear"), ""), *wr = jstr(jget(m, "record_holder"), "");
+    s64(e + 0x1d0, *fc ? maker_pid(fc, NULL) : 0); s64(e + 0x1d8, *wr ? maker_pid(wr, NULL) : 0);
+    s32(e + 0x1e0, (uint32_t)jnum(jget(m, "record_ms"), 0)); s32(e + 0x1e4, 0);
+    s32(e + 0x1e8, (uint32_t)jnum(jget(m, "comments"), 0));
+    s64(e + 0x1f0, id);
+    if (g64(e + 0x200)) s8(g64(e + 0x200), 0);
+    s8(e + 0x310, 0); s32(e + 0x314, 0);
+    if (g64(e + 0x320)) s8(g64(e + 0x320), 0);
+    s64(e + 0x398, id);
+    if (g64(e + 0x3a8)) s8(g64(e + 0x3a8), 0);
+    s8(e + 0x4b8, 0); s32(e + 0x4bc, 0);
+    if (g64(e + 0x4c8)) s8(g64(e + 0x4c8), 0);
+    s8(e + 0x540, 1);   // valid
+}
+
+// The courses of a server answer ({"courses": [...]}) into the course ring; band < 4 keeps one difficulty. Returns how many
+static uint32_t courses_into_ring(uint64_t no, J *list, uint32_t band, const char *only_holder, const char *only_first) {
+    uint64_t ring = no + RING_COURSES, entries = g64(ring);
+    uint32_t cap = g32(ring + 8), count = 0;
+    s64(ring + 0xc, 0);   // head and count
+    for (int i = 0; i < jlen(list) && count < cap && entries; i++) {
+        J *m = jat(list, i);
+        uint32_t id;
+        if (!id_of(jstr(jget(m, "code"), ""), &id)) continue;
+        if (band < 4 && band_of(m) != band) continue;
+        if (only_holder && strcmp(jstr(jget(m, "record_holder"), ""), only_holder)) continue;
+        if (only_first && strcmp(jstr(jget(m, "first_clear"), ""), only_first)) continue;
+        fill_course(entries + (uint64_t)COURSE_ENTRY * count++, m, id);
+    }
+    s32(ring + 0x10, count);
+    return count;
+}
