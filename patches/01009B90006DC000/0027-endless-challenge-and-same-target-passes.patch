+        uint32_t lives = (uint32_t)jnum(jget(run, "lives"), 0), clears = (uint32_t)jnum(jget(run, "clears"), 0), coins = (uint32_t)jnum(jget(run, "coins"), 0), score = (uint32_t)jnum(jget(run, "score"), 0);
+        int cont = jnum(jget(run, "active"), 0) && lives && !jnum(jget(run, "complete"), 0);
+        uint8_t lv = (uint8_t)(lives > 255 ? 255 : lives);
+        uint64_t r = e_record(no, d);
+        s8(r, 1); s32(r + 4, cont); s8(r + 8, cont ? (uint8_t)(coins % 100) : 0); s32(r + 0xc, cont ? score : 0);
+        s8(r + 0x10, cont ? lv : 0); s8(r + 0x11, 5); s64(r + 0x18, 0); s64(r + 0x20, 0);
+        s8(r + 0x28, (uint8_t)cont); s32(r + 0x2c, cont ? clears : 0); s8(r + 0x30, cont ? lv : 0);
+        g_erun[d].coins = coins; g_erun[d].score = score;
+    }
+    unlock(no);
+    pthread_mutex_unlock(&g_erun_mu);
+    jfree(st);
+    finish(regs, no, 1, 0);
+}
+static void w_endless_new(uint64_t *regs) {   // InitEndlessMode: New Game
+    uint64_t no = regs[0]; uint32_t d = e_diff(no, E_DIFF);
+    char path[64]; snprintf(path, sizeof path, "/api/endless/%s/start?ruleset=smm2", ENDLESS_DIFF[d]);
+    J *j = srv_json("POST", path, "{\"ruleset\":\"smm2\"}", 10000, NULL);
+    if (j) { pthread_mutex_lock(&g_erun_mu); memset(&g_erun[d], 0, sizeof g_erun[d]); pthread_mutex_unlock(&g_erun_mu); }
+    LOG("smm2 online: Endless New Game (%s): %s", ENDLESS_DIFF[d], j ? "started" : "the server refused");
+    int ok = j != NULL; jfree(j);
+    finish(regs, no, ok, 2);
+}
+static void w_endless_history(uint64_t *regs) {   // GetEndlessModePlayInfo: the map's dots, from each difficulty's history (no run there: 404, an empty map)
+    uint64_t no = regs[0]; J *h[4];
+    for (int d = 0; d < 4; d++) { char path[64]; snprintf(path, sizeof path, "/api/endless/%s/history?ruleset=smm2", ENDLESS_DIFF[d]); h[d] = srv_json("GET", path, NULL, 10000, NULL); }
+    lock(no);
+    for (int d = 0; d < 4; d++) {
+        uint64_t ring = no + E_HISTORY + 0x498ull * (uint64_t)d, entries = g64(ring);
+        uint32_t cap = g32(ring + 8), count = 0;
+        s64(ring + 0xc, 0);
+        J *list = jget(h[d], "history");
+        int n = jlen(list);
+        for (int i = n > (int)cap ? n - (int)cap : 0; i < n && entries; i++) {
+            J *e = jat(list, i); uint32_t id;
+            if (!id_of(jstr(jget(e, "code"), ""), &id)) continue;
+            uint64_t p = entries + 0x18ull * count++;
+            s64(p, id); s32(p + 8, strcmp(jstr(jget(e, "result"), ""), "clear") != 0);   // 0 a clear, 1 a skip
+            s32(p + 0xc, (uint32_t)jnum(jget(e, "seq"), 0));
+            s8(p + 0x10, (uint8_t)e_style(jstr(jget(e, "style"), ""))); s8(p + 0x11, (uint8_t)jnum(jget(e, "theme"), 0));
+        }
+        s32(ring + 0x10, count);
+    }
+    unlock(no);
+    for (int d = 0; d < 4; d++) jfree(h[d]);
+    finish(regs, no, 1, 0);
+}
+static void w_endless_rank(uint64_t *regs) {   // GetEndlessModeRank: the player's place on this phone's board
+    uint64_t no = regs[0]; uint32_t d = e_diff(no, E_DIFF);
+    char path[64]; snprintf(path, sizeof path, "/api/rankings/endless_%s?limit=1", ENDLESS_DIFF[d]);
+    J *j = srv_json("GET", path, NULL, 10000, NULL);
+    uint32_t rank = (uint32_t)jnum(jget(jget(j, "me"), "rank"), 0);
+    jfree(j);
+    lock(no); s32(no + E_RANK, rank ? rank : 0xffffffffu); unlock(no);
+    finish(regs, no, 1, 0);
+}
+static void w_endless_search(uint64_t *regs) {   // SearchCourses type 14: the run's next courses. The first batch of a difficulty is gathered from TGRCode, about a minute (this is the game's network thread, it waits)
+    uint64_t no = regs[0]; uint32_t d = e_diff(no, 0x746ec);
+    char path[64]; snprintf(path, sizeof path, "/api/endless/%s/next?count=10&ruleset=smm2", ENDLESS_DIFF[d]);
+    J *j = srv_json("GET", path, NULL, 180000, NULL);
+    if (!j) { LOG("smm2 online: Endless course list (%s): no answer", ENDLESS_DIFF[d]); finish(regs, no, 0, 2); return; }
+    lock(no);
+    uint32_t n = courses_into_ring(no, jget(j, "courses"), 4, NULL, NULL);
+    for (uint32_t i = 0; i < n; i++) s32(g64(no + RING_COURSES) + (uint64_t)COURSE_ENTRY * i + 0x180, d);
+    s8(no + 0x737ac, 0);
+    unlock(no);
+    pthread_mutex_lock(&g_erun_mu); g_esearch = (int)d; pthread_mutex_unlock(&g_erun_mu);
+    LOG("smm2 online: Endless course list (%s): %u courses", ENDLESS_DIFF[d], n);
+    jfree(j);
+    finish(regs, no, n > 0, 2);
+}
+static void w_endless_start(uint64_t *regs) {   // StartEndlessModeCourse: posted when a course starts, and again during a miss (the life it costs)
+    uint64_t no = regs[0], id = g64(no + E_COURSE_ID); uint32_t d = e_diff(no, E_DIFF);
+    char code[12], body[96]; code_of((uint32_t)id, code);
+    pthread_mutex_lock(&g_erun_mu); int miss = id && g_erun[d].started == id; g_erun[d].started = id; pthread_mutex_unlock(&g_erun_mu);
+    J *j;
+    if (!miss) { J *all = srv_json("GET", "/api/endless", NULL, 10000, NULL), *run = jget(jget(all, "runs"), ENDLESS_DIFF[d]); if (run) e_play(no, d, run); LOG("smm2 online: Endless course %s (%s), %d lives", code, ENDLESS_DIFF[d], (int)jnum(jget(run, "lives"), -1)); int ok = run != NULL; jfree(all); finish(regs, no, ok, 2); return; }
+    snprintf(body, sizeof body, "{\"code\":\"%s\",\"result\":\"death\"}", code);
+    j = e_result(d, code, body);
+    if (j) { e_play(no, d, j); LOG("smm2 online: Endless miss on %s, %d lives%s", code, (int)jnum(jget(j, "lives"), -1), jnum(jget(j, "game_over"), 0) ? " (game over)" : ""); }
+    int ok = j != NULL; jfree(j);
+    finish(regs, no, ok, 2);
+}
+static void w_endless_clear(uint64_t *regs) {   // DominateEndlessModeCourse: a clear
+    uint64_t no = regs[0], id = g64(no + E_CLEAR_ID); uint32_t d = e_diff(no, E_DIFF), pending = g8(no + 0xeabf4), coins = g8(no + 0xeabf5), score = g32(no + 0xeabf8);
+    pthread_mutex_lock(&g_erun_mu);
+    uint32_t dcoins = (coins + 100 - g_erun[d].coins % 100) % 100, dscore = score >= g_erun[d].score ? score - g_erun[d].score : 0;   // (the game sends coins below 100)
+    pthread_mutex_unlock(&g_erun_mu);
+    char code[12], body[192]; code_of((uint32_t)id, code);
+    snprintf(body, sizeof body, "{\"code\":\"%s\",\"result\":\"clear\",\"pending\":%u,\"coins\":%u,\"score\":%u,\"frames_left\":0}", code, pending, dcoins, dscore);
+    J *j = e_result(d, code, body);
+    if (j) {
+        e_play(no, d, j);
+        pthread_mutex_lock(&g_erun_mu); g_erun[d].coins += dcoins; g_erun[d].score += dscore; g_erun[d].started = 0; pthread_mutex_unlock(&g_erun_mu);
+        LOG("smm2 online: Endless clear %s, %d lives, %d clears", code, (int)jnum(jget(j, "lives"), -1), (int)jnum(jget(j, "clears"), -1));
+    }
+    int ok = j != NULL; jfree(j);
+    finish(regs, no, ok, 2);
+}
+static void w_endless_skip(uint64_t *regs) {   // PassEndlessModeCourse: a skip. The game's course end puts its counters back to the course's start and takes a life if its own flag says so, so the server's lives go into both and the flag is cleared
+    uint64_t no = regs[0], id = g64(no + E_COURSE_ID); uint32_t d = e_diff(no, E_DIFF);
+    char code[12], body[96]; code_of((uint32_t)id, code);
+    snprintf(body, sizeof body, "{\"code\":\"%s\",\"result\":\"skip\",\"during_miss\":false}", code);
+    J *j = e_result(d, code, body);
+    if (j) {
+        uint32_t lives = (uint32_t)jnum(jget(j, "lives"), 0);
+        e_play(no, d, j);
+        uint64_t run = g64(M(G_ENDLESS_RUN));
+        if (run >= 0x7000000000ull) {
+            for (int k = 0; k < 2; k++) { uint64_t ct = g64(run + (k ? 0x40 : 0x30)), lp = ct >= 0x7000000000ull ? g64(ct + 8) : 0; if (lp >= 0x7000000000ull) for (int i = 0; i < 4; i++) s32(lp + 4 * i, lives); }
+            s8(run + 0x48, 0);
+        }
+        pthread_mutex_lock(&g_erun_mu); g_erun[d].started = 0; pthread_mutex_unlock(&g_erun_mu);
+        LOG("smm2 online: Endless skip %s, %u lives", code, lives);
+    }
+    int ok = j != NULL; jfree(j);
+    finish(regs, no, ok, 2);
+}
+static void e_simple(uint64_t *regs, const char *what) {
+    uint64_t no = regs[0]; uint32_t d = e_diff(no, E_DIFF);
+    char path[64]; snprintf(path, sizeof path, "/api/endless/%s/%s?ruleset=smm2", ENDLESS_DIFF[d], what);
+    J *j = srv_json("POST", path, "{}", 10000, NULL);
+    pthread_mutex_lock(&g_erun_mu); g_erun[d].started = 0; pthread_mutex_unlock(&g_erun_mu);
+    LOG("smm2 online: Endless %s (%s)%s", what, ENDLESS_DIFF[d], j ? "" : ": the server refused");
+    int ok = j != NULL; jfree(j);
+    finish(regs, no, ok, 2);
+}
+static void w_endless_suspend(uint64_t *regs) { e_simple(regs, "suspend"); }   // SuspendEndlessMode: quit, the run is kept
+static void w_endless_finish(uint64_t *regs) { e_simple(regs, "finish"); }     // FinishEndlessMode: game over
+static void w_course_broken(uint64_t *regs) {   // ReportFromBugDetection: the game found a downloaded course corrupt. In a run it leaves the server's queue, or the next search would hand it out again
+    uint64_t no = regs[0], id = g64(no + 0x141480);
+    int d = -1;
+    pthread_mutex_lock(&g_erun_mu);
+    for (int i = 0; i < 4 && d < 0; i++) if (id && g_erun[i].started == id) d = i;
+    if (d < 0) d = g_esearch;
+    pthread_mutex_unlock(&g_erun_mu);
+    if (d >= 0) { char code[12], body[96]; code_of((uint32_t)id, code); snprintf(body, sizeof body, "{\"code\":\"%s\",\"result\":\"broken\"}", code); jfree(e_result((uint32_t)d, code, body)); LOG("smm2 online: course %s reported corrupt by the game, out of the Endless run", code); }
+    finish(regs, no, 1, 0);
+}
