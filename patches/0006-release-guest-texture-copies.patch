+// ---------- Guest copies of uploaded textures (nxkit) ----------
+// A texture filled from a CPU_NO_ACCESS pool (tex_init_fill) lives twice: in the guest memory the game read its file into, and in its private Metal copy. The CPU may not touch such a pool,
+// so once the upload's GPU work is done (the GPU deswizzle reads the pool at execution time) the whole pages of the texture's storage go back to the system (MADV_FREE_REUSABLE): Luigi's
+// Mansion 3 held 2.4 GB of guest memory beside 3.0 GB of Metal textures when iOS closed it. Checked again at release: the range must still be in the same pool buffer (a finalized pool's
+// memory goes back to the game, which may have rewritten it). Such a texture is not evicted (tex_evict_idle: its content is now only on the GPU). DM_NVN_GUEST_RELEASE=0 turns it off
+static void gpu_dst_add(id<MTLTexture> t);   // tex_evict_idle
+typedef struct { uint64_t lo, hi, fence; void *buf; } gr_ent;
+static gr_ent *g_gr; static size_t g_gr_n, g_gr_cap; static pthread_mutex_t g_gr_mu = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t g_gr_bytes, g_gr_done, g_gr_skip, g_gr_fail, g_gr_logs; static int g_gr_errno;
+static int guest_release_on(void) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("DM_NVN_GUEST_RELEASE"); on = !e || atoi(e) != 0; if (on) MLOG("guest texture copies: released after upload (CPU_NO_ACCESS pools; DM_NVN_GUEST_RELEASE=0 turns it off)"); }
+    return on;
+}
+static void guest_release_queue(uint64_t a, uint64_t n) {
+    const uint64_t pg = 16384; uint64_t lo = (a + pg - 1) & ~(pg - 1), hi = (a + n) & ~(pg - 1);
+    if (hi <= lo) return;
+    void *mb; uint64_t mo; if (!mtl_addr(a, n, &mb, &mo)) return;
+    pthread_mutex_lock(&g_gr_mu);
+    if (g_gr_n == g_gr_cap) { size_t nc = g_gr_cap ? g_gr_cap * 2 : 1024; gr_ent *ne = realloc(g_gr, nc * sizeof *ne); if (!ne) { pthread_mutex_unlock(&g_gr_mu); return; } g_gr = ne; g_gr_cap = nc; }
+    g_gr[g_gr_n++] = (gr_ent){lo, hi, g_fence + 2, mb};
+    pthread_mutex_unlock(&g_gr_mu);
+}
+void guest_release_drain(void) {   // mtl_sub_begin, no lock held
+    if (!g_gr_n) return;
+    pthread_mutex_lock(&g_mu); uint64_t done = g_done; pthread_mutex_unlock(&g_mu);
+    uint64_t freed = 0;
+    pthread_mutex_lock(&g_gr_mu);
+    for (size_t i = 0; i < g_gr_n;) {
+        gr_ent e = g_gr[i];
+        if (e.fence > done) { i++; continue; }
+        g_gr[i] = g_gr[--g_gr_n];
+        pthread_mutex_lock(&g_mu); int k = pool_find(e.lo, e.hi - e.lo); int alive = k >= 0 && (__bridge void *)g_pools[k].buf == e.buf; pthread_mutex_unlock(&g_mu);
+        if (!alive) { g_gr_skip++; continue; }
+        if (madvise((void *)(uintptr_t)e.lo, e.hi - e.lo, MADV_FREE_REUSABLE)) { g_gr_fail++; g_gr_errno = errno; continue; }
+        freed += e.hi - e.lo; g_gr_done++;
+    }
+    pthread_mutex_unlock(&g_gr_mu);
+    g_gr_bytes += freed;
+    if ((freed || g_gr_fail) && (g_gr_logs++ < 20 || g_gr_logs % 100 == 0))
+        MLOG("guest texture copies released: %llu MB now, %llu MB in %llu textures in total (pool gone before the release %llu, madvise failed %llu, last errno %d)",
+             (unsigned long long)(freed >> 20), (unsigned long long)(g_gr_bytes >> 20), (unsigned long long)g_gr_done, (unsigned long long)g_gr_skip, (unsigned long long)g_gr_fail, g_gr_errno);
+}
